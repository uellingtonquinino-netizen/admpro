{
  "name": "otimizzai-financas",
  "version": "1.0.53",
  "description": "Sistema financeiro desktop — Otimizzai",
  "main": "dist-main/main.js",
  "author": {
    "name": "Otimizzai",
    "email": "dev@otimizzai.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:web": "vite --config vite.web.config.ts --mode web",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && electron .",
    "build": "npm run build:vite && npm run build:main && npm run build:preload",
    "build:vite": "vite build",
    "build:web": "vite build --config vite.web.config.ts --mode web",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:publish": "npm run build && electron-builder --win --publish always",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.js",
    "supabase:schema": "npm run build:main && node scripts/run-supabase-schema.js",
    "supabase:export-data": "node scripts/run-supabase-data-export.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.1.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.323.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "pdf.js-extract": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.2",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  }
}
