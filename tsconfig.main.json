{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "CommonJS",
    "lib":              ["ES2020"],
    "outDir":           "dist-main",
    "rootDir":          "src/main",
    "strict":           true,
    "skipLibCheck":     true,
    "resolveJsonModule": true,
    "esModuleInterop":  true,
    "moduleResolution": "node",
    "sourceMap":        true,
    "declaration":      false,
    "noUnusedLocals":   false
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
