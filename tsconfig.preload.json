{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "CommonJS",
    "lib":              ["ES2020", "DOM"],
    "outDir":           "dist-preload",
    "rootDir":          "src/preload",
    "strict":           true,
    "skipLibCheck":     true,
    "esModuleInterop":  true,
    "moduleResolution": "node",
    "sourceMap":        false,
    "declaration":      false
  },
  "include": ["src/preload/**/*"],
  "exclude": ["node_modules"]
}
